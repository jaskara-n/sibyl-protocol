# ─── Sibyl environment ─────────────────────────────────────────────────────
# Copy to .env and fill in. Most on-chain ADDRESSES are read automatically from
# deployments/mantle-sepolia.json — you usually only need the RPC URL.

# Mantle Sepolia RPC endpoint (reads + writes).
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz

# Web frontend -> API base URL. Set this on Vercel to your Render API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ─── Live round engine (apps/api) ──────────────────────────────────────────
# The continuous on-the-record benchmark. Reads are always on.
ROUNDS_ENABLED=true
# On-chain recording is OFF by default. Set to 1 ONLY if you want the server to
# broadcast new ConsensusReached txs on an interval (requires PRIVATE_KEY below).
ROUNDS_CHAIN_EMIT=0
ROUNDS_CHAIN_EMIT_INTERVAL_SEC=600

# Keep replay commits as a dry-run unless you are intentionally writing on-chain.
COMMIT_REPLAY_DRY_RUN=true

# ─── Secrets (writes only — leave blank for a read-only deployment) ─────────
# Ledger-owner key used to sign on-chain writes (replay commits / live rounds).
# Use a throwaway TESTNET wallet with a little Mantle Sepolia MNT for gas.
# NEVER commit this. Set it only in your host's secret env panel.
PRIVATE_KEY=

# ─── Optional address overrides (defaults come from deployments json) ───────
# SIBYL_LEDGER_ADDRESS=0x1C4cCc2c917EDF45aD1C3C9675cF130b47Db8c11
# SIBYL_VAULT_ADDRESS=0x62c494cca2df8fF04960d2A73CB723D862554916
# SIBYL_PREDICTION_MARKET_ADDRESS=0xfCf5180c83E1A753eaFf489508154430354A7682

# Optional: restrict the API's CORS to your frontend origin (open by default).
# CORS_ORIGIN=https://your-app.vercel.app
