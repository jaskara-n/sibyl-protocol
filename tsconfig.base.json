{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@sibyl/shared": ["packages/shared/src/index.ts"],
      "@sibyl/agents": ["packages/agents/src/index.ts"],
      "@sibyl/sdk": ["packages/sdk/src/index.js"]
    }
  }
}
